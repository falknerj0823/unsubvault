# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=unsubvault
POSTGRES_PASSWORD=change_me            # use a long random value; it must match DATABASE_URL below
POSTGRES_DB=unsubvault
DATABASE_URL=postgresql://unsubvault:change_me@db:5432/unsubvault   # required

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_random_32_chars   # openssl rand -hex 32 (required, min 32 chars)
ADMIN_PASSWORD=change_me_min_8_chars      # UI login password (required)
FRONTEND_URL=http://localhost:3000

# ─── Microsoft OAuth (Live / Outlook / 365) ──────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers

# ─── Google OAuth (Gmail) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── LLM Backend (choose one) ────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# ─── Scan settings ───────────────────────────────────────────────────────────
SCAN_BATCH_SIZE=50
DRY_RUN=true

# ─── Optional: install Claude Code / Codex CLIs in the image (subscription LLM providers) ─
INSTALL_AI_CLIS=false

# ─── Network (optional) ──────────────────────────────────────────────────────
# The UI listens on this machine only. To reach it from other devices (a home server or NAS), read docs/home-server.md first.
# BIND_ADDRESS=127.0.0.1
# PORT=3000
